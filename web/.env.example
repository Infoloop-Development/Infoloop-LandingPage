# ---------------------------------------------------------------------------
# infoloop.co (web/). Copy to .env for local work; set the real values on the
# Render web service (Environment tab). Astro inlines these at BUILD time, so a
# changed value needs a redeploy, which Render triggers when you save it.
#
# Every variable here is OPTIONAL. With none of them set the site builds from
# the local content files in src/content/ and ships no tracking at all, which
# is exactly what /privacy currently describes.
# ---------------------------------------------------------------------------

# --- Payload CMS -----------------------------------------------------------
# Leave unset to build purely from the local content files. When set, Payload
# globals and collections are deep-merged OVER the local content at build time.
PAYLOAD_URL=
# Users API key — required for chatbot → Sales Inquiry Tickets.
# Generate locally: cd cms && npx tsx scripts/ensure-chatbot-api-key.ts
PAYLOAD_TOKEN=
# Signs the per-ticket tokens the chatbot hands to a browser (see docs/CHATBOT-MODULE.md).
# Generate: openssl rand -hex 32. Falls back to PAYLOAD_TOKEN when empty.
CHAT_TICKET_SECRET=
# Set to "true" in a preview context to read Payload drafts instead of published.
PAYLOAD_PREVIEW=

# --- Contact form ----------------------------------------------------------
# Where /api/contact delivers leads (Zapier / Make / Slack / HubSpot webhook).
# UNSET MEANS SUBMISSIONS GO NOWHERE. Set this before launch.
CONTACT_WEBHOOK_URL=

# --- Site chatbot (Groq) ---------------------------------------------------
# Free key from https://console.groq.com — required for /api/chat.
# Must be present at BUILD time on Netlify (same as CONTACT_WEBHOOK_URL).
# Without it the widget still shows but replies with a “not configured” message.
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-20b
GROQ_MODEL=

# --- CRM (optional) --------------------------------------------------------
# Attio API key (Settings > Developers > API keys), needs record read+write.
# ADDITIVE to CONTACT_WEBHOOK_URL, not a replacement: an Attio failure is
# logged but never fails the lead. Confirm your workspace's attribute slugs
# against GET https://api.attio.com/v2/objects/people/attributes first.
ATTIO_API_KEY=

# --- Search Console / Business Profile -------------------------------------
# Only needed if you verify Search Console by meta tag instead of DNS.
PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools (msvalidate.01) and Ahrefs (ahrefs-site-verification) meta
# tags. Both optional, neither sets a cookie. Also editable in the CMS analytics screen.
PUBLIC_BING_VERIFICATION=
PUBLIC_AHREFS_VERIFICATION=

# --- Analytics -------------------------------------------------------------
# Preferred: set IDs in Payload CMS → Settings → Analytics & tracking.
# These PUBLIC_* vars are a fallback when CMS fields are empty. Setting ANY
# tracker (CMS or env) without privacy disclosure fails the build.
TRACKING_DISCLOSED=

# Cookieless, no consent banner needed in most jurisdictions.
PUBLIC_PLAUSIBLE_DOMAIN=
# Cookie-based. Needs a consent banner in the EU/UK; none ships with this site.
PUBLIC_GA4_ID=
# Use INSTEAD of PUBLIC_GA4_ID if you want to manage tags in GTM.
PUBLIC_GTM_ID=
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
PUBLIC_CLARITY_ID=
PUBLIC_LINKEDIN_PARTNER_ID=

# Consent. A banner shows automatically whenever any cookie-setting tracker
# above is configured. Set to "false" ONLY on legal advice that your audience
# does not require consent. Google Consent Mode v2 is used either way.
PUBLIC_CONSENT_REQUIRED=
