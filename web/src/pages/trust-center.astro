---
/**
 * /trust-center: the questions a careful buyer asks before signing.
 * Ownership, day to day practice, and an explicit "what we do not claim"
 * section. No certification is claimed anywhere on this page.
 */
import Site from "@/layouts/Site.astro";
import { TaglineBand } from "@/components/sections/TaglineBand";
import { CtaPanel } from "@/components/sections/CtaPanel";
import { Cross } from "@/components/about/AboutParts";
import { Hi, Check } from "@/components/ui";
import { getCompany, getSite } from "@/lib/cms";
const T = (await getCompany()).trust;

const site = await getSite();
const S = site.site;
const url = `${S.url}/trust-center`;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", "@id": `${url}#page`, url, name: T.seo.title, description: T.seo.description, isPartOf: { "@id": `${S.url}/#website` }, about: { "@type": "Organization", "@id": `${S.url}/#organization`, name: "Infoloop", url: S.url }, inLanguage: "en" },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${S.url}/` }, { "@type": "ListItem", position: 2, name: "Trust center", item: url }] },
];
---
<Site title={T.seo.title} description={T.seo.description} canonical="/trust-center" jsonLd={jsonLd} image={T.seo.image?.url} imageAlt={T.seo.image?.alt} noindex={!!T.seo.noindex}>
  <section class="border-b border-ink" aria-labelledby="trust-h1">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow text-ink/70 hero-in">{T.eyebrow}</p>
      <h1 id="trust-h1" class="display-h2 mt-3 max-w-4xl text-ink hero-in" style="--d: 60ms"><Hi text={T.h1} /></h1>
      <p class="lede mt-4 max-w-3xl text-ink/80 hero-in" style="--d: 120ms">{T.lede}</p>
      <a href="/contact" class="btn btn-ink mt-8 hero-in" style="--d: 180ms">{T.button}</a>
    </div>
  </section>

  <TaglineBand data={T.band} />

  {/* Ownership: the thing buyers are really asking about */}
  <section class="container-x py-14 sm:py-20" aria-labelledby="own-h2">
    <h2 id="own-h2" class="display-h2 text-ink reveal">{T.ownership.h2}</h2>
    <p class="lede mt-3 max-w-3xl text-ink/80 reveal" style="--reveal-delay: 60ms">{T.ownership.lede}</p>
    <ul class="mt-8 grid auto-rows-fr gap-3 sm:grid-cols-2">
      {T.ownership.items.map((it, i) => (
        <li class="flex reveal" style={`--reveal-delay: ${120 + i * 60}ms`}>
          <div class="flex w-full gap-4 border border-ink bg-white p-7">
            <Check className="mt-1 h-5 w-5 shrink-0 text-orange" />
            <div>
              <h3 class="font-display text-[19px] font-bold leading-tight text-ink">{it.title}</h3>
              <p class="mt-2 text-[15.5px] leading-relaxed text-ink/80">{it.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </section>

  {/* Practice: dark */}
  <section class="bg-ink text-white" aria-labelledby="prac-h2">
    <div class="container-x py-14 sm:py-20">
      <h2 id="prac-h2" class="display-h2 text-white reveal">{T.practice.h2}</h2>
      <p class="lede mt-3 max-w-3xl text-white/75 reveal" style="--reveal-delay: 60ms">{T.practice.lede}</p>
      <ul class="mt-8 grid gap-px border border-white/20 bg-white/20 sm:grid-cols-2 lg:grid-cols-3">
        {T.practice.items.map((it, i) => (
          <li class="bg-ink p-7 reveal" style={`--reveal-delay: ${120 + i * 50}ms`}>
            <h3 class="font-display text-[17px] font-bold leading-tight text-white">{it.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/70">{it.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* What we do not claim */}
  <section class="container-x py-14 sm:py-20" aria-labelledby="honest-h2">
    <h2 id="honest-h2" class="display-h2 text-ink reveal">{T.honest.h2}</h2>
    <p class="lede mt-3 max-w-3xl text-ink/80 reveal" style="--reveal-delay: 60ms">{T.honest.lede}</p>
    <ul class="mt-8 divide-y divide-ink border border-ink bg-white reveal" style="--reveal-delay: 120ms">
      {T.honest.items.map((it) => (
        <li class="flex gap-4 p-6">
          <span class="mt-1 shrink-0"><Cross /></span>
          <p class="text-[16.5px] leading-relaxed text-ink/85">{it}</p>
        </li>
      ))}
    </ul>
  </section>

  {/* Reporting: copy and the action on the left, what to send on the right,
      so the panel is not a wide box with an empty half. */}
  <section class="container-x pb-14 sm:pb-20" aria-labelledby="report-h2">
    <div class="grid gap-8 border border-ink bg-paper p-8 sm:p-10 lg:grid-cols-12 lg:items-center lg:gap-12">
      <div class="lg:col-span-7">
        <h2 id="report-h2" class="display-h3 text-ink">{T.report.h2}</h2>
        <p class="mt-3 text-[16.5px] leading-relaxed text-ink/80">{T.report.lede}</p>
        <a href={`mailto:${S.email}`} class="btn btn-ink mt-6">{T.report.button}</a>
        <p class="mt-4 font-display text-[13px] font-semibold tracking-[0.02em] text-ink/60">{S.email}</p>
      </div>
      <div class="lg:col-span-5">
        <div class="border border-ink bg-white p-6 sm:p-7">
          <h3 class="font-display text-[13px] font-bold uppercase tracking-[0.12em] text-ink">{T.report.include.title}</h3>
          <ul class="mt-4 space-y-3">
            {T.report.include.items.map((it) => (
              <li class="flex gap-3 text-[15.5px] leading-snug text-ink/80">
                <span class="mt-[7px] h-2 w-2 shrink-0 bg-orange" aria-hidden="true"></span>
                {it}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <CtaPanel id="trust-cta-h2" h2={T.cta.h2} lede={T.cta.lede} button={{ label: T.cta.button, href: "/contact" }} />
</Site>
