---
/**
 * /industry/<slug>: 7Span's industry page format (their /industry/manufacturing):
 * hero (eyebrow, H1 left, line right, wide visual with the button overlapping)
 * → context (hatched rail) → four numbers → challenges we solve → marquee →
 * case studies (tabs) → what you get (dark) → trusted-by strip → one client
 * quote → blogs → FAQs → CTA → footer. First page: Manufacturing.
 */
import Site from "@/layouts/Site.astro";
import { TaglineBand } from "@/components/sections/TaglineBand";
import { TrustStrip } from "@/components/sections/TrustStrip";
import { Faq } from "@/components/sections/Faq";
import { CtaPanel } from "@/components/sections/CtaPanel";
import { PostCard } from "@/components/blog/PostCards";
import { FeaturedTabs } from "@/components/work/WorkIndex";
import { IndustryHero, IndustryContext, NumbersRow, Challenges, Outcomes, BigQuote } from "@/components/industry/IndustryParts";

import { TRUST } from "@/content/home";
import { getPosts, toMeta } from "@/lib/posts";
import { getIndustries, getSite, getWork } from "@/lib/cms";

export async function getStaticPaths() {
  return (await getIndustries()).map((d) => ({ params: { industry: d.slug }, props: { d } }));
}
const { d } = Astro.props;
const site = await getSite();
const S = site.site;
const url = `${S.url}/industry/${d.slug}`;
const cases = await getWork();
const tabs = d.cases.items.map((it) => ({ it, c: cases.find((c) => c.slug === it.slug) })).filter((x) => x.c).map((x) => ({ label: x.it.label, c: x.c! }));
const all = (await getPosts()).map(toMeta);
const posts = [...all.filter((p) => p.categories.includes(d.blogCategory)), ...all.filter((p) => !p.categories.includes(d.blogCategory))].slice(0, 3);
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", "@id": `${url}#page`, url, name: d.seo.title, description: d.seo.description, isPartOf: { "@id": `${S.url}/#website` }, about: { "@type": "Thing", name: `${d.name} software` }, inLanguage: "en" },
  { "@context": "https://schema.org", "@type": "Service", "@id": `${url}#service`, name: `Software for ${d.name.toLowerCase()}`, description: d.lede, url, provider: { "@type": "Organization", "@id": `${S.url}/#organization`, name: "Infoloop", url: S.url }, audience: { "@type": "BusinessAudience", name: d.name }, areaServed: { "@type": "Country", name: "United States" } },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: d.faq.items.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${S.url}/` }, { "@type": "ListItem", position: 2, name: d.name, item: url }] },
];
---
<Site title={d.seo.title} description={d.seo.description} canonical={`/industry/${d.slug}`} jsonLd={jsonLd} image={d.seo.image?.url} imageAlt={d.seo.image?.alt}>
  <IndustryHero d={d} />
  <IndustryContext d={d} />
  <NumbersRow items={d.numbers} />
  <Challenges d={d} />
  <TaglineBand data={d.band} />

  {/* Case studies: heading + the work page's tabbed panel (7Span) */}
  <div class="container-x pt-14 sm:pt-20">
    <h2 id="cases-h2" class="display-h2 text-ink reveal">{d.cases.h2}</h2>
    <p class="mt-3 text-[18px] text-ink/80 reveal sm:text-[20px]" style="--reveal-delay: 60ms">{d.cases.lede}</p>
  </div>
  <div class="pb-14 sm:pb-20">
    <FeaturedTabs tabs={tabs} button={d.cases.button} labelledBy="cases-h2" />
  </div>

  <Outcomes d={d} />
  {/* Trusted-by strip with the company numbers (the page numbers row above already carries the industry ones) */}
  <TrustStrip data={{ ...TRUST, h2: d.trust.h2, sub: d.trust.sub }} />
  <BigQuote q={d.quote} photoAlt={`Photo slot: a ${d.name.toLowerCase()} client site`} />

  {posts.length > 0 && (
    <section class="container-x border-t border-ink py-14 sm:py-20" aria-labelledby="blogs-h2">
      <h2 id="blogs-h2" class="display-h2 text-ink reveal">Blogs and insights</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((p, i) => <PostCard post={p} index={i + 1} />)}
      </ul>
    </section>
  )}

  <Faq data={d.faq} />
  <CtaPanel id="ind-cta-h2" h2={d.cta.h2} lede={d.cta.lede} button={{ label: d.cta.button, href: "/contact" }} />
</Site>
