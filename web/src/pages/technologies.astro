---
/**
 * /technologies: 7Span keeps a Technologies page under Company. Ours follows
 * the same shape: hero (H1, sub, paragraph, panel), marquee, a tabbed panel
 * with the category rail on the left and the tools on the right, then how we
 * choose, and the CTA. Tabs are CSS radios, so there is no JavaScript.
 * Tiles carry a lettered mark rather than a vendor logo until logo use is
 * cleared; the copy is what each tool is for, in plain words.
 */
import Site from "@/layouts/Site.astro";
import { TaglineBand } from "@/components/sections/TaglineBand";
import { CtaPanel } from "@/components/sections/CtaPanel";
import { RatingsRow } from "@/components/sections/RatingsRow";
import { ArrowUpRight, Hi } from "@/components/ui";
import { getSite, getTechnologies } from "@/lib/cms";
const T = await getTechnologies();

const site = await getSite();
const S = site.site;
const url = `${S.url}/technologies`;
const all = T.groups.flatMap((g) => g.items);
const hatch = "repeating-linear-gradient(135deg, rgba(10,10,10,0.35) 0 1px, transparent 1px 7px)";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: T.seo.title,
    description: T.seo.description,
    isPartOf: { "@id": `${S.url}/#website` },
    about: { "@type": "Organization", "@id": `${S.url}/#organization`, name: "Infoloop", url: S.url, knowsAbout: all.map((i) => i.name) },
    mainEntity: { "@type": "ItemList", numberOfItems: all.length, itemListElement: all.map((i, n) => ({ "@type": "ListItem", position: n + 1, name: i.name, description: i.what })) },
    inLanguage: "en",
  },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${S.url}/` }, { "@type": "ListItem", position: 2, name: "Technologies", item: url }] },
];
---
<Site title={T.seo.title} description={T.seo.description} canonical="/technologies" jsonLd={jsonLd} image={T.seo.image?.url} imageAlt={T.seo.image?.alt} noindex={!!T.seo.noindex}>
  {/* Hero: copy left, a panel of every mark on the right (7Span runs a video here) */}
  <section class="relative" aria-labelledby="tech-h1">
    <div class="container-x grid gap-10 py-12 sm:py-16 lg:grid-cols-12 lg:items-center lg:gap-14">
      <div class="lg:col-span-7">
        <p class="eyebrow text-ink/70 hero-in">{T.eyebrow}</p>
        <h1 id="tech-h1" class="display-h2 mt-3 text-ink hero-in" style="--d: 60ms"><Hi text={T.h1} /></h1>
        <p class="mt-4 font-display text-[20px] font-medium leading-snug tracking-[-0.01em] text-ink hero-in sm:text-[22px]" style="--d: 100ms">{T.sub}</p>
        <p class="mt-4 max-w-2xl text-[16.5px] leading-relaxed text-ink/80 hero-in" style="--d: 140ms">{T.lede}</p>
        <a href="/contact" class="btn btn-ink mt-8 hero-in" style="--d: 180ms">{T.button}</a>
      </div>
      <div class="lg:col-span-5 hero-fade" style="--d: 180ms">
        <div class="p-4 sm:p-6" style={`background-image: ${hatch}`}>
          <ul class="grid grid-cols-3 gap-2 border border-ink bg-white p-2" aria-hidden="true">
            {all.map((i) => (
              <li class="flex aspect-square items-center justify-center border border-ink/15 bg-paper font-display text-[15px] font-bold tracking-[-0.02em] text-ink">{i.badge}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TaglineBand data={T.band} />

  {/* Tabbed panel: rail of categories, one pane of tools at a time (7Span) */}
  <section class="container-x py-14 sm:py-20 ttabs" aria-labelledby="panel-h2">
    <h2 id="panel-h2" class="display-h2 text-ink reveal">{T.panel.h2}</h2>
    <p class="lede mt-3 max-w-3xl text-ink/80 reveal" style="--reveal-delay: 60ms">{T.panel.lede}</p>

    <fieldset class="mt-8 grid min-w-0 border border-ink bg-white lg:grid-cols-12 reveal" style="--reveal-delay: 120ms">
      <legend class="sr-only">Choose a technology group</legend>
      <div class="flex overflow-x-auto border-b border-ink lg:col-span-4 lg:flex-col lg:overflow-visible lg:border-b-0 lg:border-r">
        {T.groups.map((g, i) => (
          <span class="relative shrink-0 lg:w-full">
            <input type="radio" name="tech-group" id={`tt-${i}`} class="sr-only" checked={i === 0} />
            <label for={`tt-${i}`} class="ttab block cursor-pointer select-none border-r border-line bg-paper px-5 py-4 font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-ink/60 transition-colors hover:text-ink lg:border-b lg:border-r-0">
              {g.label}
              <span class="ml-2 text-ink/40">{g.items.length}</span>
            </label>
          </span>
        ))}
      </div>

      <div class="lg:col-span-8">
        {T.groups.map((g, i) => (
          <div class="tpane p-6 sm:p-8" data-i={i}>
            <h3 class="font-display text-[24px] font-bold leading-tight tracking-[-0.02em] text-ink sm:text-[28px]">{g.h2}</h3>
            <p class="mt-2 max-w-2xl text-[15.5px] leading-relaxed text-ink/75">{g.lede}</p>
            <ul class="mt-6 grid gap-2 sm:grid-cols-2">
              {g.items.map((it) => (
                <li class="flex">
                  <a href={it.hire ?? "/contact"} class="group flex w-full gap-4 border border-ink bg-white p-4 transition-colors hover:bg-paper">
                    <span class="flex h-11 w-11 shrink-0 items-center justify-center bg-ink font-display text-[13px] font-bold tracking-[-0.02em] text-white" aria-hidden="true">{it.badge}</span>
                    <span class="min-w-0">
                      <span class="flex items-center gap-2 font-display text-[16.5px] font-bold text-ink group-hover:text-orange">
                        {it.name}
                        <ArrowUpRight className="h-3.5 w-3.5 shrink-0" />
                      </span>
                      <span class="mt-1 block text-[14px] leading-relaxed text-ink/70">{it.what}</span>
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </fieldset>
  </section>

  {/* How we choose: dark, the honest bit 7Span leaves out */}
  <section class="bg-ink text-white" aria-labelledby="choose-h2">
    <div class="container-x py-14 sm:py-20">
      <h2 id="choose-h2" class="display-h2 text-white reveal">{T.choose.h2}</h2>
      <p class="lede mt-3 max-w-3xl text-white/75 reveal" style="--reveal-delay: 60ms">{T.choose.lede}</p>
      <ul class="mt-8 grid gap-px border border-white/20 bg-white/20 sm:grid-cols-2">
        {T.choose.items.map((c, i) => (
          <li class="bg-ink p-7 reveal" style={`--reveal-delay: ${120 + i * 60}ms`}>
            <h3 class="font-display text-[19px] font-bold leading-tight text-white">{c.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/70">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaPanel id="tech-cta-h2" h2={T.cta.h2} lede={T.cta.lede} button={{ label: T.cta.button, href: "/contact" }} />
  <RatingsRow ratings={site.ratings} />
</Site>
