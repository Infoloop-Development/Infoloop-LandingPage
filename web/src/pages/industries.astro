---
/**
 * /industries: the "All industries" hub. Same shape as /services, with the
 * four menu groups and a card per industry page (the card line is that
 * page's own H1 promise, with the highlight markers stripped).
 */
import Site from "@/layouts/Site.astro";
import { TaglineBand } from "@/components/sections/TaglineBand";
import { HubGroups } from "@/components/hub/HubGroups";
import { CtaPanel } from "@/components/sections/CtaPanel";
import { RatingsRow } from "@/components/sections/RatingsRow";
import { Hi } from "@/components/ui";
import { HUBS } from "@/content/hubs";
import { INDUSTRIES } from "@/content/site";
import { getIndustries, getSite } from "@/lib/cms";

const hub = HUBS.find((h) => h.slug === "industries")!;
const site = await getSite();
const S = site.site;
const url = `${S.url}/industries`;
const pages = await getIndustries();
const plain = (s: string) => s.replace(/\[\[|\]\]/g, "");
const groups = INDUSTRIES.map((g) => ({
  title: g.title,
  cards: g.items
    .map((it) => pages.find((d) => `/industry/${d.slug}` === it.href))
    .filter(Boolean)
    .map((d) => ({ title: d!.name, line: plain(d!.h1), href: `/industry/${d!.slug}` })),
})).filter((g) => g.cards.length > 0);
const count = groups.reduce((n, g) => n + g.cards.length, 0);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${url}#page`,
    url,
    name: hub.seo.title,
    description: hub.seo.description,
    isPartOf: { "@id": `${S.url}/#website` },
    about: { "@type": "Organization", "@id": `${S.url}/#organization`, name: "Infoloop", url: S.url },
    mainEntity: { "@type": "ItemList", numberOfItems: count, itemListElement: groups.flatMap((g) => g.cards).map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.title, url: `${S.url}${c.href}` })) },
    inLanguage: "en",
  },
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${S.url}/` }, { "@type": "ListItem", position: 2, name: "Industries", item: url }] },
];
---
<Site title={hub.seo.title} description={hub.seo.description} canonical="/industries" jsonLd={jsonLd}>
  <section class="border-b border-ink" aria-labelledby="hub-h1">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow text-ink/70 hero-in">{hub.eyebrow}</p>
      <h1 id="hub-h1" class="display-h2 mt-3 max-w-4xl text-ink hero-in" style="--d: 60ms"><Hi text={hub.h1} /></h1>
      <p class="lede mt-4 max-w-3xl text-ink/80 hero-in" style="--d: 120ms">{hub.lede}</p>
      <a href="/contact" class="btn btn-ink mt-8 hero-in" style="--d: 180ms">{hub.button}</a>
    </div>
  </section>

  <TaglineBand data={hub.band} />

  <section class="container-x pt-14 sm:pt-20" aria-labelledby="groups-h2">
    <h2 id="groups-h2" class="display-h2 text-ink reveal">{hub.groupsH2}</h2>
    <p class="lede mt-3 max-w-3xl text-ink/80 reveal" style="--reveal-delay: 60ms">{hub.groupsLede}</p>
  </section>
  <div class="py-10 sm:py-12">
    <HubGroups groups={groups} />
  </div>

  <CtaPanel id="hub-cta-h2" h2={hub.cta.h2} lede={hub.cta.lede} button={{ label: hub.cta.button, href: "/contact" }} />
  <RatingsRow ratings={site.ratings} />
</Site>
