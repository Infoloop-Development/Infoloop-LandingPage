---
/**
 * /careers: what working here is like, how hiring works, and the open roles.
 * `CAREERS.roles` is empty until there is a real opening, and the page shows
 * the "nothing open" panel instead of inventing one.
 */
import Site from "@/layouts/Site.astro";
import { TaglineBand } from "@/components/sections/TaglineBand";
import { Process } from "@/components/sections/Process";
import { CtaPanel } from "@/components/sections/CtaPanel";
import { Hi, ArrowUpRight } from "@/components/ui";
import { CAREERS as C } from "@/content/company";
import { getSite } from "@/lib/cms";

const site = await getSite();
const S = site.site;
const url = `${S.url}/careers`;
const apply = `mailto:${S.careersEmail}`;
const jsonLd = [
  { "@context": "https://schema.org", "@type": "WebPage", "@id": `${url}#page`, url, name: C.seo.title, description: C.seo.description, isPartOf: { "@id": `${S.url}/#website` }, about: { "@type": "Organization", "@id": `${S.url}/#organization`, name: "Infoloop", url: S.url }, inLanguage: "en" },
  ...C.roles.map((r) => ({ "@context": "https://schema.org", "@type": "JobPosting", title: r.title, description: r.blurb, employmentType: r.type, hiringOrganization: { "@type": "Organization", name: "Infoloop", sameAs: S.url }, jobLocation: { "@type": "Place", address: { "@type": "PostalAddress", addressLocality: r.place } } })),
  { "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${S.url}/` }, { "@type": "ListItem", position: 2, name: "Careers", item: url }] },
];
---
<Site title={C.seo.title} description={C.seo.description} canonical="/careers" jsonLd={jsonLd}>
  <section class="border-b border-ink" aria-labelledby="careers-h1">
    <div class="container-x py-12 sm:py-16">
      <p class="eyebrow text-ink/70 hero-in">{C.eyebrow}</p>
      <h1 id="careers-h1" class="display-h2 mt-3 max-w-4xl text-ink hero-in" style="--d: 60ms"><Hi text={C.h1} /></h1>
      <p class="lede mt-4 max-w-3xl text-ink/80 hero-in" style="--d: 120ms">{C.lede}</p>
      <a href={apply} class="btn btn-ink mt-8 hero-in" style="--d: 180ms">{C.button}</a>
    </div>
  </section>

  <TaglineBand data={C.band} />

  {/* Open roles first: it is what people came for */}
  <section class="container-x py-14 sm:py-20" aria-labelledby="roles-h2">
    <h2 id="roles-h2" class="display-h2 text-ink reveal">{C.openings.h2}</h2>
    <p class="lede mt-3 max-w-3xl text-ink/80 reveal" style="--reveal-delay: 60ms">{C.openings.lede}</p>
    {C.roles.length > 0 ? (
      <ul class="mt-8 divide-y divide-ink border border-ink reveal" style="--reveal-delay: 120ms">
        {C.roles.map((r) => (
          <li>
            <a href={r.href ?? apply} class="group grid gap-2 p-6 transition-colors hover:bg-paper sm:grid-cols-12 sm:items-center">
              <span class="sm:col-span-5">
                <span class="block font-display text-[19px] font-bold text-ink group-hover:text-orange">{r.title}</span>
                <span class="mt-1 block text-[15px] text-ink/70">{r.blurb}</span>
              </span>
              <span class="font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-ink/60 sm:col-span-3">{r.team}</span>
              <span class="font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-ink/60 sm:col-span-2">{r.place}</span>
              <span class="flex items-center justify-between gap-3 font-display text-[12px] font-semibold uppercase tracking-[0.12em] text-ink sm:col-span-2 sm:justify-end">
                {r.type}
                <ArrowUpRight className="h-4 w-4" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="mt-8 grid gap-6 border border-ink bg-white p-8 sm:p-10 lg:grid-cols-12 lg:items-center reveal" style="--reveal-delay: 120ms">
        <div class="lg:col-span-8">
          <p class="font-display text-[22px] font-bold leading-tight tracking-[-0.02em] text-ink">{C.openings.emptyTitle}</p>
          <p class="mt-3 max-w-2xl text-[16.5px] leading-relaxed text-ink/80">{C.openings.emptyBody}</p>
        </div>
        <div class="lg:col-span-4 lg:justify-self-end">
          <a href={apply} class="btn btn-primary px-7 py-4">{C.openings.button}</a>
        </div>
      </div>
    )}
  </section>

  {/* What it is like: dark */}
  <section class="bg-ink text-white" aria-labelledby="life-h2">
    <div class="container-x py-14 sm:py-20">
      <h2 id="life-h2" class="display-h2 text-white reveal">{C.life.h2}</h2>
      <p class="lede mt-3 max-w-3xl text-white/75 reveal" style="--reveal-delay: 60ms">{C.life.lede}</p>
      <ul class="mt-8 grid gap-px border border-white/20 bg-white/20 sm:grid-cols-2">
        {C.life.items.map((it, i) => (
          <li class="bg-ink p-7 reveal" style={`--reveal-delay: ${120 + i * 60}ms`}>
            <h3 class="font-display text-[19px] font-bold leading-tight text-white">{it.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-white/70">{it.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Process data={C.how} />

  <section class="container-x border-t border-ink py-14 sm:py-20" aria-labelledby="where-h2">
    <h2 id="where-h2" class="display-h2 text-ink reveal">{C.where.h2}</h2>
    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {C.where.items.map((w) => (
        <li class="border border-ink bg-white p-7 reveal">
          <h3 class="font-display text-[19px] font-bold text-ink">{w.title}</h3>
          <p class="mt-2 text-[15.5px] text-ink/75">{w.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <CtaPanel id="careers-cta-h2" h2={C.cta.h2} lede={C.cta.lede} button={{ label: C.cta.button, href: apply }} />
</Site>
