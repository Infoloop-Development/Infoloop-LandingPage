---
/**
 * Tracking, wired but OFF until someone sets an environment variable.
 *
 * Nothing here loads on a build with no PUBLIC_* vars set, which is the
 * default. That matters: /privacy states plainly that the site runs no
 * analytics, no tracking cookies and no advertising pixels, and that stays
 * literally true until the first variable is set in the Netlify UI.
 *
 * THE MOMENT YOU SET ONE, UPDATE /privacy. Set TRACKING_DISCLOSED=true in the
 * same deploy: it flips the privacy copy to the version that discloses
 * analytics. The build fails if a tracker is on and that flag is not set, so
 * the policy cannot silently drift out of date. See docs/TRACKING.md.
 *
 * Loading order is deliberate: analytics must never block the page, so every
 * script is async or deferred and none of them run before first paint.
 */
const env = import.meta.env;

// Cookieless, no consent banner required in most jurisdictions.
const plausible = env.PUBLIC_PLAUSIBLE_DOMAIN;
// Cookie-based. Needs consent in the EU/UK and a privacy-policy disclosure.
const ga4 = env.PUBLIC_GA4_ID;
const gtm = env.PUBLIC_GTM_ID;
const posthog = env.PUBLIC_POSTHOG_KEY;
const posthogHost = env.PUBLIC_POSTHOG_HOST ?? "https://eu.i.posthog.com";
const clarity = env.PUBLIC_CLARITY_ID;
const linkedIn = env.PUBLIC_LINKEDIN_PARTNER_ID;

// Google Search Console ownership. Prefer DNS verification; this meta tag is
// the fallback when DNS is not available to whoever is doing the setup.
const gscVerify = env.PUBLIC_GSC_VERIFICATION;

/*
 * Consent. GA4 and Clarity both set cookies, so the EU/UK need a lawful basis
 * before they run. We use Google Consent Mode v2 rather than simply blocking
 * the tag: consent starts denied, GA4 still receives cookieless pings so
 * totals are not lost, and a grant upgrades it in place. Clarity has its own
 * consent call. Set PUBLIC_CONSENT_REQUIRED=false only if you have taken
 * advice that your audience does not need it.
 */
const consentRequired = env.PUBLIC_CONSENT_REQUIRED !== "false";
const cookieTrackers = Boolean(ga4 || gtm || posthog || clarity || linkedIn);
const showConsent = consentRequired && cookieTrackers;

const anyTracker = Boolean(plausible || ga4 || gtm || posthog || clarity || linkedIn);
const disclosed = env.TRACKING_DISCLOSED === "true";

// A hard stop rather than a warning. A site whose privacy policy denies the
// tracking it actually runs is a legal problem, not a cosmetic one.
if (anyTracker && !disclosed) {
  throw new Error(
    "Tracking is configured but TRACKING_DISCLOSED is not 'true'.\n" +
      "Set TRACKING_DISCLOSED=true only after updating the privacy policy to\n" +
      "disclose what you now collect. See web/docs/TRACKING.md.",
  );
}
// A cookie-setting tracker with consent switched off is a deliberate choice,
// so say so at build time rather than letting it pass silently.
if (cookieTrackers && !consentRequired) {
  console.warn("[analytics] Cookie-setting trackers are on with PUBLIC_CONSENT_REQUIRED=false. No consent is collected. See web/docs/TRACKING.md.");
}
---
{gscVerify && <meta name="google-site-verification" content={gscVerify} />}

{plausible && (
  <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>
)}

{showConsent && (
  <script is:inline>
    /* Consent Mode v2 defaults, set before any Google tag loads. */
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    var stored = null;
    try { stored = localStorage.getItem("il-consent"); } catch (e) {}
    var granted = stored === "granted";
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: granted ? "granted" : "denied",
      functionality_storage: "granted",
      security_storage: "granted",
      wait_for_update: 500,
    });
    window.__ilConsent = stored;
  </script>
)}

{gtm && (
  <script is:inline define:vars={{ gtm }}>
    (function (w, d, s, i) {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", gtm);
  </script>
)}

{ga4 && !gtm && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
    <script is:inline define:vars={{ ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      /* IP anonymisation is on by default in GA4; ads signals are not, and we
         do not turn them on. Nothing here is shared with advertising. */
      gtag("config", ga4, { anonymize_ip: true, allow_google_signals: false, allow_ad_personalization_signals: false });
    </script>
  </>
)}

{posthog && (
  <script is:inline define:vars={{ posthog, posthogHost }}>
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    window.posthog.init(posthog, { api_host: posthogHost, person_profiles: "identified_only" });
  </script>
)}

{clarity && (
  <script is:inline define:vars={{ clarity, showConsent }}>
    /* Clarity records sessions, so it waits for a grant when consent applies. */
    if (!showConsent || window.__ilConsent === "granted") {
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", clarity);
    }
  </script>
)}

{linkedIn && (
  <script is:inline define:vars={{ linkedIn }}>
    window._linkedin_partner_id = linkedIn;
    window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
    window._linkedin_data_partner_ids.push(linkedIn);
    (function (l) {
      var s = document.getElementsByTagName("script")[0];
      var b = document.createElement("script");
      b.type = "text/javascript"; b.async = true;
      b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
      s.parentNode.insertBefore(b, s);
    })(window.lintrk);
  </script>
)}

