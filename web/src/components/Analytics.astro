---
/**
 * Tracking scripts. IDs come from the Payload `analytics` global at build
 * time (CMS UI), with PUBLIC_* env vars as fallback. See docs/TRACKING.md.
 *
 * Privacy: any tracker requires privacyDisclosed. Saving analytics in the
 * CMS triggers a site rebuild so tags appear without a code deploy.
 */
import { getAnalytics, anyTracker, cookieTrackers } from "@/lib/analytics";

const cfg = await getAnalytics();
const plausible = cfg.plausibleDomain;
const ga4 = cfg.ga4Id;
const gtm = cfg.gtmId;
const posthog = cfg.posthogKey;
const posthogHost = cfg.posthogHost || "https://eu.i.posthog.com";
const clarity = cfg.clarityId;
const linkedIn = cfg.linkedinPartnerId;
const gscVerify = cfg.gscVerification;
/*
 * Bing and Ahrefs verification. Meta-tag based, no cookie, outside the consent
 * gate. Bing matters more than its search share suggests: ChatGPT's web search
 * runs on Bing's index. Ahrefs verification unlocks the full crawl in Site Audit.
 */
const bingVerify = cfg.bingVerification;
const ahrefsVerify = cfg.ahrefsVerification;

const consentRequired = cfg.consentRequired;
const hasCookieTrackers = cookieTrackers(cfg);
const showConsent = consentRequired && hasCookieTrackers;
const trackersOn = anyTracker(cfg);
const disclosed = cfg.privacyDisclosed;

if (trackersOn && !disclosed) {
  throw new Error(
    "Tracking is configured but privacy disclosure is off.\n" +
      "In CMS → Analytics & tracking, tick \"Privacy policy updated\", or set\n" +
      "TRACKING_DISCLOSED=true. See web/docs/TRACKING.md.",
  );
}
if (hasCookieTrackers && !consentRequired) {
  console.warn("[analytics] Cookie-setting trackers are on with consent off. No consent is collected. See web/docs/TRACKING.md.");
}
---
{gscVerify && <meta name="google-site-verification" content={gscVerify} />}
{bingVerify && <meta name="msvalidate.01" content={bingVerify} />}
{ahrefsVerify && <meta name="ahrefs-site-verification" content={ahrefsVerify} />}

{plausible && (
  <script is:inline defer data-domain={plausible} src="https://plausible.io/js/script.js"></script>
)}

{showConsent && (
  <script is:inline>
    /* Consent Mode v2 defaults, set before any Google tag loads. */
    window.dataLayer = window.dataLayer || [];
    function gtag() { window.dataLayer.push(arguments); }
    window.gtag = window.gtag || gtag;
    var stored = null;
    try { stored = localStorage.getItem("il-consent"); } catch (e) {}
    var granted = stored === "granted";
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: granted ? "granted" : "denied",
      functionality_storage: "granted",
      security_storage: "granted",
      wait_for_update: 500,
    });
    window.__ilConsent = stored;
  </script>
)}

{gtm && (
  <script is:inline define:vars={{ gtm }}>
    (function (w, d, s, i) {
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
      j.async = true;
      j.src = "https://www.googletagmanager.com/gtm.js?id=" + i;
      f.parentNode.insertBefore(j, f);
    })(window, document, "script", gtm);
  </script>
)}

{ga4 && !gtm && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}></script>
    <script is:inline define:vars={{ ga4 }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", ga4, { anonymize_ip: true, allow_google_signals: false, allow_ad_personalization_signals: false });
    </script>
  </>
)}

{posthog && (
  <script is:inline define:vars={{ posthog, posthogHost, showConsent }}>
    /* PostHog sets cookies, so it waits for a grant when consent applies (ConsentBanner starts it on Allow). */
    window.__ilStartPosthog = function () {
    if (window.posthog && window.posthog.__loaded) return;
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    window.posthog.init(posthog, { api_host: posthogHost, person_profiles: "identified_only" });
    };
    if (!showConsent || window.__ilConsent === "granted") window.__ilStartPosthog();
  </script>
)}

{clarity && (
  <script is:inline define:vars={{ clarity, showConsent }}>
    if (!showConsent || window.__ilConsent === "granted") {
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1;
      t.src = "https://www.clarity.ms/tag/" + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, "clarity", "script", clarity);
    }
  </script>
)}

{linkedIn && (
  <script is:inline define:vars={{ linkedIn, showConsent }}>
    /* LinkedIn Insight sets cookies, so it waits for a grant when consent applies (ConsentBanner starts it on Allow). */
    window.__ilStartLinkedIn = function () {
    if (window.__ilLinkedInStarted) return;
    window.__ilLinkedInStarted = true;
    window._linkedin_partner_id = linkedIn;
    window._linkedin_data_partner_ids = window._linkedin_data_partner_ids || [];
    window._linkedin_data_partner_ids.push(linkedIn);
    (function (l) {
      var s = document.getElementsByTagName("script")[0];
      var b = document.createElement("script");
      b.type = "text/javascript"; b.async = true;
      b.src = "https://snap.licdn.com/li.lms-analytics/insight.min.js";
      s.parentNode.insertBefore(b, s);
    })(window.lintrk);
    };
    if (!showConsent || window.__ilConsent === "granted") window.__ilStartLinkedIn();
  </script>
)}

{trackersOn && (
  <script is:inline>
    /* Shared conversion helper for GA4 / GTM / Plausible / PostHog. */
    window.ilTrack = function (name, props) {
      props = props || {};
      props.page = props.page || (typeof location !== "undefined" ? location.pathname : "");
      try {
        /* One push, not two: in GTM mode window.gtag is the consent stub that already
           writes to dataLayer, so pushing an event object as well double-counted every
           conversion. The plain push is only for a container with no gtag stub. */
        if (typeof window.gtag === "function") {
          window.gtag("event", name, props);
        } else {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push(Object.assign({ event: name }, props));
        }
      } catch (e) {}
      try {
        if (typeof window.plausible === "function") window.plausible(name, { props: props });
      } catch (e) {}
      try {
        if (window.posthog && typeof window.posthog.capture === "function") window.posthog.capture(name, props);
      } catch (e) {}
    };
    document.addEventListener("click", function (e) {
      var el = e.target instanceof Element ? e.target : null;
      var a = el && el.closest("a[href]");
      if (!a) return;
      var href = a.getAttribute("href") || "";
      var page = location.pathname;
      if (href.indexOf("tel:") === 0) window.ilTrack("phone_click", { target: href.slice(4), page: page });
      else if (href.indexOf("mailto:") === 0) window.ilTrack("email_click", { target: href.slice(7), page: page });
      else if (href.indexOf("wa.me/") > -1) window.ilTrack("whatsapp_click", { page: page });
      else if (href.indexOf("/downloads/") === 0) window.ilTrack("file_download", { file: href, page: page });
    });
  </script>
)}
