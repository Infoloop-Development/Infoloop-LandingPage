# Postgres (Neon). Create a project at https://neon.tech, copy the pooled
# connection string. Keep ?sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Long random string used to sign auth tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# Public URL of this CMS once deployed (Railway/Render), no trailing slash.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:4321,https://infoloop.co

# Netlify build hook. Publishing in the CMS POSTs here to rebuild the site.
NETLIFY_BUILD_HOOK_URL=
